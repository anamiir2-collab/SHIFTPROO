+    // ====== Android hardware back button ======
+    // Native Android UX: back button should close any open sheet/modal first,
+    // and only exit the app when no sheet is open. Capacitor's App plugin
+    // fires a `backButton` event whose default action is to navigate WebView
+    // history and then exit the app. We override only while a sheet is open.
+    if (global.Capacitor && global.Capacitor.isNativePlatform && global.Capacitor.isNativePlatform()) {
+      try {
+        const AppPlugin = global.Capacitor.Plugins && global.Capacitor.Plugins.App;
+        if (AppPlugin && typeof AppPlugin.addListener === 'function') {
+          AppPlugin.addListener('backButton', ({ canGoBack }) => {
+            const openSheets =
+              document.querySelectorAll('.sheet.show, .sheet-overlay.show');
+            if (openSheets.length > 0) {
+              openSheets.forEach((n) => n.classList.remove('show'));
+              return; // consume: sheets closed, do not exit
+            }
+            // No sheet open: respect default behavior. If WebView has history
+            // (e.g. law-reader pushed a state), go back; otherwise exit app.
+            if (canGoBack) {
+              window.history.back();
+            } else {
+              // Capacitor's default action (exit) runs because we did not
+              // call listener.preventDefault(). We force-exit only if the
+              // bridge didn't already.
+              try {
+                const App2 = global.Capacitor.Plugins && global.Capacitor.Plugins.App;
+                if (App2 && typeof App2.exitApp === 'function') App2.exitApp();
+              } catch (e) { /* fall through */ }
+            }
+          });
+        }
+      } catch (e) {
+        console.warn('[back-button] Capacitor App plugin not available:', e);
+      }
+    }
+
